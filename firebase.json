{
  "hosting": {
    "target": "sgcmed-pruebas",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/expedientes.html"
      },
      {
        "source": "**",
        "destination": "/expedientes.html"
      }
    ]
  }
}
